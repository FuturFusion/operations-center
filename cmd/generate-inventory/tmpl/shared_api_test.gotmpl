package api_test

import (
	"net/url"
	"testing"

	"github.com/stretchr/testify/require"

	"github.com/FuturFusion/operations-center/shared/api"
)

func Test{{ .Name | pascalcase }}Filter_AppendToURLValues(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name   string
		filter api.{{ .Name | pascalcase }}Filter

		want string
	}{
		{
			name:   "empty filter",
			filter: api.{{ .Name | pascalcase }}Filter{},

			want: ``,
		},
		{
			name: "complete filter",
			filter: api.{{ .Name | pascalcase }}Filter{
				Cluster:     new("cluster"),
{{- if .ServerIDByLocation }}
				Server:      new("server"),
{{- end }}
{{- if .HasProject }}
				ProjectName: new("project"),
{{- end }}
				Expression:  new("true"),
			},

			want: `cluster=cluster&filter=true{{ if .HasProject }}&project=project{{ end }}{{ if .ServerIDByLocation }}&server=server{{ end }}`,
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			query := tc.filter.AppendToURLValues(url.Values{})

			require.Equal(t, tc.want, query.Encode())
		})
	}
}
