package inventory_test

import (
	"net/url"
	"testing"

	incusapi "github.com/lxc/incus/v7/shared/api"
	"github.com/stretchr/testify/require"

	"github.com/FuturFusion/operations-center/internal/domain"
	"github.com/FuturFusion/operations-center/internal/inventory"
	"github.com/FuturFusion/operations-center/internal/util/testing/uuidgen"
	"github.com/FuturFusion/operations-center/shared/api"
)

func TestIncus{{ .ObjectType | pascalcase }}Wrapper_Value(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name string

		{{ .ObjectType | camelcase }} inventory.Incus{{ .ObjectType | pascalcase }}Wrapper

		assertErr require.ErrorAssertionFunc
	}{
		{
			name: "success",

			{{ .ObjectType | camelcase }}: inventory.Incus{{ .ObjectType | pascalcase }}Wrapper{
				{{ .ObjectType | pascalcase }}: incusapi.{{ .ObjectType | pascalcase }}{},
			},

			assertErr: require.NoError,
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			_, err := tc.{{ .ObjectType | camelcase }}.Value()

			tc.assertErr(t, err)
		})
	}
}

func TestIncus{{ .ObjectType | pascalcase }}Wrapper_Scan(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name string

		value any

		assertErr require.ErrorAssertionFunc
	}{
		{
			name: "success - []byte",

			value: []byte(`{}`),

			assertErr: require.NoError,
		},
		{
			name: "success - string",

			value: `{}`,

			assertErr: require.NoError,
		},
		{
			name: "error - nil",

			assertErr: require.Error,
		},
		{
			name: "error - unsupported type",

			value: 1, // not supported for Incus{{ .ObjectType | pascalcase }}Wrapper

			assertErr: require.Error,
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			updateFiles := inventory.Incus{{ .ObjectType | pascalcase }}Wrapper{}

			err := updateFiles.Scan(tc.value)

			tc.assertErr(t, err)
		})
	}
}

func Test{{ .Name | pascalcase }}_Validate(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name  string
		{{ .Name | camelcase }} *inventory.{{ .Name | pascalcase }}

		assertErr require.ErrorAssertionFunc
	}{
		{
			name: "valid",
			{{ .Name | camelcase }}: (&inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "one",
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
				Server:      new("one"),
	{{- else }}
				Server:      "one",
	{{- end }}
{{- end }}
{{- if .HasProject }}
				ProjectName: "project one",
{{- end }}
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: "{{ .ParentName | camelcase }} one",
{{- end }}
				Name:        "one",
			}).DeriveUUID(),

			assertErr: require.NoError,
		},
		{
			name: "error - invalid cluster ID",
			{{ .Name | camelcase }}: (&inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "", // invalid
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
				Server:      new("one"),
	{{- else }}
				Server:      "one",
	{{- end }}
{{- end }}
{{- if .HasProject }}
				ProjectName: "project one",
{{- end }}
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: "{{ .ParentName | camelcase }} one",
{{- end }}
				Name:        "one",
			}).DeriveUUID(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				var verr domain.ErrValidation
				require.ErrorAs(tt, err, &verr, a...)
			},
		},
{{- if and .ServerIDByLocation ( not .IsServerIDOptional ) }}
		{
			name: "error - invalid project name",
			{{ .Name | camelcase }}: (&inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "one",
				Server:      "", // invalid
{{- if .HasProject }}
				ProjectName: "project one",
{{- end }}
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: "{{ .ParentName | camelcase }} one",
{{- end }}
				Name:        "one",
			}).DeriveUUID(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				var verr domain.ErrValidation
				require.ErrorAs(tt, err, &verr, a...)
			},
		},
{{- end }}
{{- if .HasProject }}
		{
			name: "error - invalid project name",
			{{ .Name | camelcase }}: (&inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "one",
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
				Server:      new("one"),
	{{- else }}
				Server:      "one",
	{{- end }}
{{- end }}
				ProjectName: "", // invalid
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: "{{ .ParentName | camelcase }} one",
{{- end }}
				Name:        "one",
			}).DeriveUUID(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				var verr domain.ErrValidation
				require.ErrorAs(tt, err, &verr, a...)
			},
		},
{{- end }}
{{- if .HasParent }}
		{
			name: "error - invalid project name",
			{{ .Name | camelcase }}: (&inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "one",
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
				Server:      new("one"),
	{{- else }}
				Server:      "one",
	{{- end }}
{{- end }}
{{- if .HasProject }}
				ProjectName: "project one",
{{- end }}
				{{ .ParentName | pascalcase }}Name: "", // invalid
				Name:        "one",
			}).DeriveUUID(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				var verr domain.ErrValidation
				require.ErrorAs(tt, err, &verr, a...)
			},
		},
{{- end }}
		{
			name: "error - invalid name",
			{{ .Name | camelcase }}: (&inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "one",
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
				Server:      new("one"),
	{{- else }}
				Server:      "one",
	{{- end }}
{{- end }}
{{- if .HasProject }}
				ProjectName: "project one",
{{- end }}
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: "{{ .ParentName | camelcase }} one",
{{- end }}
				Name:        "", // invalid
			}).DeriveUUID(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				var verr domain.ErrValidation
				require.ErrorAs(tt, err, &verr, a...)
			},
		},
		{
			name: "error - UUID not derived",
			{{ .Name | camelcase }}: &inventory.{{ .Name | pascalcase }}{
				ID:          1,
				Cluster:     "one",
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
				Server:      new("one"),
	{{- else }}
				Server:      "one",
	{{- end }}
{{- end }}
{{- if .HasProject }}
				ProjectName: "project one",
{{- end }}
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: "{{ .ParentName | camelcase }} one",
{{- end }}
				Name:        "one",
			}, // UUID not derived

			assertErr: func(tt require.TestingT, err error, a ...any) {
				var verr domain.ErrValidation
				require.ErrorAs(tt, err, &verr, a...)
			},
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			err := tc.{{ .Name | camelcase }}.Validate()

			tc.assertErr(t, err)
		})
	}
}

func Test{{ .Name | pascalcase }}_Filter(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name  string
		filter inventory.{{ .Name | pascalcase }}Filter

		want string
	}{
		{
			name: "empty filter",
			filter: inventory.{{ .Name | pascalcase }}Filter{},

			want: ``,
		},
		{
			name: "complete filter",
			filter: inventory.{{ .Name | pascalcase }}Filter{
				UUID:        new(uuidgen.FromPattern(t, "1")),
				Cluster:     new("cluster"),
{{- if .ServerIDByLocation }}
				Server:      new("server"),
{{- end }}
{{- if .HasProject }}
				ProjectName: new("project"),
{{- end }}
{{- if .HasParent }}
				{{ .ParentName | pascalcase }}Name: new("{{ .ParentName }}"),
{{- end }}
				Name:        new("name"),
				Expression:  new("true"),
			},

			want: `cluster=cluster&filter=true&name=name{{ if .HasParent }}&parent={{ .ParentName }}{{ end }}{{ if .HasProject }}&project=project{{ end }}{{ if .ServerIDByLocation }}&server=server{{ end }}&uuid=11111111-1111-1111-1111-111111111111`,
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			require.Equal(t, tc.want, tc.filter.String())
		})
	}
}

func Test{{ .Name | pascalcase }}Filter_StringMatchesAPI(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name   string
		filter api.{{ .Name | pascalcase }}Filter
	}{
		{
			name:   "empty filter",
			filter: api.{{ .Name | pascalcase }}Filter{},
		},
		{
			name:   "cluster",
			filter: api.{{ .Name | pascalcase }}Filter{Cluster: new("cluster")},
		},
{{- if .ServerIDByLocation }}
		{
			name:   "server",
			filter: api.{{ .Name | pascalcase }}Filter{Server: new("server")},
		},
{{- end }}
{{- if .HasProject }}
		{
			name:   "project",
			filter: api.{{ .Name | pascalcase }}Filter{ProjectName: new("project")},
		},
{{- end }}
		{
			name:   "expression",
			filter: api.{{ .Name | pascalcase }}Filter{Expression: new(`name == "value"`)},
		},
		{
			name: "complete filter",
			filter: api.{{ .Name | pascalcase }}Filter{
				Cluster:     new("cluster"),
{{- if .ServerIDByLocation }}
				Server:      new("server"),
{{- end }}
{{- if .HasProject }}
				ProjectName: new("project"),
{{- end }}
				Expression:  new("true"),
			},
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			// The conversion fails to compile if the fields of the API filter change.
			// Then add the field to the mapping and to the test cases.
			fields := struct {
				Cluster     *string
{{- if .ServerIDByLocation }}
				Server      *string
{{- end }}
{{- if .HasProject }}
				ProjectName *string
{{- end }}
				Expression  *string
			}(tc.filter)

			filter := inventory.{{ .Name | pascalcase }}Filter{
				Cluster:     fields.Cluster,
{{- if .ServerIDByLocation }}
				Server:      fields.Server,
{{- end }}
{{- if .HasProject }}
				ProjectName: fields.ProjectName,
{{- end }}
				Expression:  fields.Expression,
			}

			got := filter.String()

			require.Equal(t, tc.filter.AppendToURLValues(url.Values{}).Encode(), got, "the service filter uses the same query parameters as the API filter")
		})
	}
}
