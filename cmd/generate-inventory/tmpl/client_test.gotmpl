package client_test

import (
	"testing"

	"github.com/stretchr/testify/require"

	"github.com/FuturFusion/operations-center/internal/client"
	"github.com/FuturFusion/operations-center/internal/domain"
	"github.com/FuturFusion/operations-center/internal/inventory"
	"github.com/FuturFusion/operations-center/internal/inventory/repo/sqlite/entities"
	"github.com/FuturFusion/operations-center/internal/provisioning"
	provisioningEntities "github.com/FuturFusion/operations-center/internal/provisioning/repo/sqlite/entities"
	"github.com/FuturFusion/operations-center/internal/util/testing/uuidgen"
	"github.com/FuturFusion/operations-center/shared/api"
)

func Test_GetWithFilter{{ .PluralName | pascalcase }}(t *testing.T) {
	d := daemonSetup(t)

	tests := []struct {
		name       string
		client     client.OperationsCenterClient
		dbSeedFunc func(t *testing.T)

		filter api.{{ .Name | pascalcase }}Filter

		assertErr  require.ErrorAssertionFunc
		assertFunc func(t *testing.T, result []api.{{ .Name | pascalcase }})
	}{
		{
			name:       "success - empty list",
			client:     d.socketClient,
			dbSeedFunc: noop,

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Empty(t, result)
			},
		},
		{
			name:   "success - one record",
			client: d.socketClient,

			dbSeedFunc: func(t *testing.T) {
				t.Helper()

				_, err := provisioningEntities.CreateCluster(t.Context(), d.db, provisioning.Cluster{
					Name:    "clusterOne",
					Channel: "stable",
				})
				require.NoError(t, err)

{{ if .ServerIDByLocation }}
				_, err = provisioningEntities.CreateServer(t.Context(), d.db, provisioning.Server{
					Name:    "serverOne",
					Channel: "stable",
				})
				require.NoError(t, err)
{{ end }}

				_, err = entities.Create{{ .Name | pascalcaseWithoutAcronyms }}(t.Context(), d.db, inventory.{{ .Name | pascalcase }}{
					UUID:    uuidgen.FromPattern(t, "1"),
					Name:    "one",
					Cluster: "clusterOne",
{{- if .HasProject }}
					ProjectName: "default",
{{- end }}
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
					Server:  new("serverOne"),
	{{- else }}
					Server:    "serverOne",
	{{- end }}
{{- end }}
				})
				require.NoError(t, err)
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Len(t, result, 1)
				require.Equal(t, "one", result[0].Name)
			},
		},
		{
			name:       "success - filter by cluster, matching",
			client:     d.socketClient,
			dbSeedFunc: noop,

			filter: api.{{ .Name | pascalcase }}Filter{
				Cluster: new("clusterOne"),
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Len(t, result, 1)
				require.Equal(t, "one", result[0].Name)
			},
		},
		{
			name:       "success - filter by cluster, not matching",
			client:     d.socketClient,
			dbSeedFunc: noop,

			filter: api.{{ .Name | pascalcase }}Filter{
				Cluster: new("unknown"),
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Empty(t, result)
			},
		},
{{- if .ServerIDByLocation }}
		{
			name:       "success - filter by server, matching",
			client:     d.socketClient,
			dbSeedFunc: noop,

			filter: api.{{ .Name | pascalcase }}Filter{
				Server: new("serverOne"),
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Len(t, result, 1)
				require.Equal(t, "one", result[0].Name)
			},
		},
		{
			name:       "success - filter by server, not matching",
			client:     d.socketClient,
			dbSeedFunc: noop,

			filter: api.{{ .Name | pascalcase }}Filter{
				Server: new("unknown"),
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Empty(t, result)
			},
		},
{{- end }}
{{- if .HasProject }}
		{
			name:       "success - filter by project, matching",
			client:     d.socketClient,
			dbSeedFunc: noop,

			filter: api.{{ .Name | pascalcase }}Filter{
				ProjectName: new("default"),
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Len(t, result, 1)
				require.Equal(t, "one", result[0].Name)
			},
		},
		{
			name:       "success - filter by project, not matching",
			client:     d.socketClient,
			dbSeedFunc: noop,

			filter: api.{{ .Name | pascalcase }}Filter{
				ProjectName: new("unknown"),
			},

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Empty(t, result)
			},
		},
{{- end }}
		{
			name:       "error - not authorized",
			client:     d.unauthorizedHTTPClient,
			dbSeedFunc: noop,

			assertErr: func(tt require.TestingT, err error, a ...any) {
				require.ErrorIs(tt, err, domain.ErrNotAuthenticated)
			},
			assertFunc: func(t *testing.T, result []api.{{ .Name | pascalcase }}) {
				t.Helper()
			},
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			tc.dbSeedFunc(t)

			result, err := tc.client.GetWithFilter{{ .PluralName | pascalcase }}(t.Context(), tc.filter)

			tc.assertErr(t, err)
			tc.assertFunc(t, result)
		})
	}
}

func Test_Get{{ .Name | pascalcase }}(t *testing.T) {
	d := daemonSetup(t)

	tests := []struct {
		name       string
		client     client.OperationsCenterClient
		dbSeedFunc func(t *testing.T)

		tcNameArg string

		assertErr  require.ErrorAssertionFunc
		assertFunc func(t *testing.T, result api.{{ .Name | pascalcase }})
	}{
		{
			name:   "success - one record",
			client: d.socketClient,
			dbSeedFunc: func(t *testing.T) {
				t.Helper()

				_, err := provisioningEntities.CreateCluster(t.Context(), d.db, provisioning.Cluster{
					Name:    "clusterOne",
					Channel: "stable",
				})
				require.NoError(t, err)

{{ if .ServerIDByLocation }}
				_, err = provisioningEntities.CreateServer(t.Context(), d.db, provisioning.Server{
					Name:    "serverOne",
					Channel: "stable",
				})
				require.NoError(t, err)
{{ end }}

				_, err = entities.Create{{ .Name | pascalcaseWithoutAcronyms }}(t.Context(), d.db, inventory.{{ .Name | pascalcase }}{
					UUID:    uuidgen.FromPattern(t, "1"),
					Name:    "foo",
					Cluster: "clusterOne",
{{- if .ServerIDByLocation }}
	{{- if .IsServerIDOptional }}
					Server:  new("serverOne"),
	{{- else }}
					Server:  "serverOne",
	{{- end }}
{{- end }}
				})
				require.NoError(t, err)
			},

			tcNameArg: uuidgen.FromPattern(t, "1").String(),

			assertErr: require.NoError,
			assertFunc: func(t *testing.T, result api.{{ .Name | pascalcase }}) {
				t.Helper()

				require.Equal(t, "foo", result.Name)
			},
		},
		{
			name:       "error - not authorized",
			client:     d.unauthorizedHTTPClient,
			dbSeedFunc: noop,

			tcNameArg: "foo",

			assertErr: func(tt require.TestingT, err error, a ...any) {
				require.ErrorIs(tt, err, domain.ErrNotAuthenticated)
			},
			assertFunc: func(t *testing.T, result api.{{ .Name | pascalcase }}) {
				t.Helper()
			},
		},
		{
			name:       "error - not found",
			client:     d.socketClient,
			dbSeedFunc: noop,

			tcNameArg: uuidgen.FromPattern(t, "2").String(),

			assertErr: func(t require.TestingT, err error, a ...any) {
				require.ErrorIs(t, err, domain.ErrNotFound)
			},
			assertFunc: func(t *testing.T, result api.{{ .Name | pascalcase }}) {
				t.Helper()
			},
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			tc.dbSeedFunc(t)

			result, err := tc.client.Get{{ .Name | pascalcase }}(t.Context(), tc.tcNameArg)

			tc.assertErr(t, err)
			tc.assertFunc(t, result)
		})
	}
}

// Test_Resync{{ .Name | pascalcase }} only covers the error paths, which are
// handled before the Incus API of the cluster is contacted.
func Test_Resync{{ .Name | pascalcase }}(t *testing.T) {
	d := daemonSetup(t)

	tests := []struct {
		name       string
		client     client.OperationsCenterClient
		dbSeedFunc func(t *testing.T)

		tcNameArg string

		assertErr require.ErrorAssertionFunc
	}{
		{
			name:       "error - not authorized",
			client:     d.unauthorizedHTTPClient,
			dbSeedFunc: noop,

			tcNameArg: uuidgen.FromPattern(t, "1").String(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				require.ErrorIs(tt, err, domain.ErrNotAuthenticated)
			},
		},
		{
			name:       "error - not found",
			client:     d.socketClient,
			dbSeedFunc: noop,

			tcNameArg: uuidgen.FromPattern(t, "2").String(),

			assertErr: func(tt require.TestingT, err error, a ...any) {
				require.ErrorIs(tt, err, domain.ErrNotFound)
			},
		},
		{
			name:       "error - invalid uuid",
			client:     d.socketClient,
			dbSeedFunc: noop,

			tcNameArg: "not-a-uuid",

			assertErr: require.Error,
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			tc.dbSeedFunc(t)

			err := tc.client.Resync{{ .Name | pascalcase }}(t.Context(), tc.tcNameArg)

			tc.assertErr(t, err)
		})
	}
}
