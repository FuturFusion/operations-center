func (r {{ .Name | camelcase }}) Create(ctx context.Context, in inventory.{{ .Name | pascalcase }}) (inventory.{{ .Name | pascalcase }}, error) {
	return transaction.DoAndReturn(ctx, func(ctx context.Context) (inventory.{{ .Name | pascalcase }}, error) {
		const sqlStmt = `
	WITH _lookup AS (
	  SELECT id AS cluster_id {{ if .ServerIDByLocation -}}, (
	    SELECT servers.id FROM clusters
	      LEFT JOIN servers ON servers.cluster_id = clusters.id
	    WHERE clusters.name = ?2 AND servers.name = ?3
	  ) AS server_id {{ end -}}
	  FROM clusters WHERE clusters.name = ?2
	)
	INSERT INTO {{ .PluralName }} (uuid, cluster_id, {{ if .ServerIDByLocation -}} server_id, {{ end -}} {{ if .HasProject }}project_name, {{ end -}}{{ if .HasParent }}{{ .ParentName }}_name, {{ end -}} name {{- range .ExtraAttributes }}, {{ .Name }} {{- end}}, object, last_updated)
	{{- $n := 2 }}{{ if .ServerIDByLocation }}{{ $n = 3 }}{{ end }}
	VALUES (?1, (SELECT cluster_id FROM _lookup), {{ if .ServerIDByLocation -}} (SELECT server_id FROM _lookup), {{ end -}} {{ if .HasProject -}} {{ $n = add1 $n }}?{{ $n }}, {{ end -}}{{ if .HasParent }}{{ $n = add1 $n }}?{{ $n }}, {{ end -}} {{ $n = add1 $n }}?{{ $n }} {{- range .ExtraAttributes }}, {{ $n = add1 $n }}?{{ $n }} {{- end}}, {{ $n = add1 $n }}?{{ $n }}, {{ $n = add1 $n }}?{{ $n }})
	`

		marshaledObject, err := json.Marshal(in.Object.{{ .ObjectType | pascalcase }})
		if err != nil {
			return inventory.{{ .Name | pascalcase }}{}, err
		}

		_, err = r.db.ExecContext(ctx, sqlStmt,
			in.UUID,
			in.Cluster,
	{{- if .ServerIDByLocation }}
			in.Server,
	{{- end }}
	{{- if .HasProject }}
			in.ProjectName,
	{{- end }}
	{{- if .HasParent }}
			in.{{ .ParentName | pascalcase }}Name,
	{{- end }}
			in.Name,
	{{- range .ExtraAttributes }}
			in.{{ .Name | pascalcase }},
	{{- end}}
			marshaledObject,
			in.LastUpdated,
		)
		if err != nil {
			return inventory.{{ .Name | pascalcase }}{}, sqlite.MapErr(err)
		}

		// cowsql doesn't support RETURNING.
		return r.GetByUUID(ctx, in.UUID)
	})
}

func (r {{ .Name | camelcase }}) GetAllWithFilter(ctx context.Context, filter inventory.{{ .Name | pascalcase }}Filter) (inventory.{{ .PluralName | pascalcase }}, error) {
	return transaction.DoAndReturn(ctx, func(ctx context.Context) (inventory.{{ .PluralName | pascalcase }}, error) {
		const sqlStmt = `
	SELECT
	  {{ .PluralName }}.id, {{ .PluralName }}.uuid, clusters.name, {{ if .ServerIDByLocation -}} servers.name, {{ end -}} {{ if .HasProject -}} {{ .PluralName }}.project_name, {{ end -}}{{ if .HasParent -}} {{ .PluralName }}.{{ .ParentName }}_name, {{ end -}} {{ .PluralName }}.name {{- range .ExtraAttributes }}, {{ $.PluralName }}.{{ .Name }} {{- end}}, {{ .PluralName }}.object, {{ .PluralName }}.last_updated
	FROM {{ .PluralName }}
	  INNER JOIN clusters ON {{ .PluralName }}.cluster_id = clusters.id
	{{- if .ServerIDByLocation }}
	  {{ if .IsServerIDOptional }}LEFT{{ else }}INNER{{ end}} JOIN servers ON {{ .PluralName }}.server_id = servers.id
	{{- end }}
	WHERE true
	%s
	ORDER BY clusters.name, {{ if .ServerIDByLocation -}} servers.name, {{ end -}} {{ .PluralName }}.name
	`

		var whereClause []string
		var args []any

		if filter.Cluster != nil {
			whereClause = append(whereClause, ` AND clusters.name = ?`)
			args = append(args, filter.Cluster)
		}

	{{ if .ServerIDByLocation }}
		if filter.Server != nil {
			whereClause = append(whereClause, ` AND servers.name = ?`)
			args = append(args, filter.Server)
		}
	{{ end }}

	{{ if .HasProject }}
		if filter.ProjectName != nil {
			whereClause = append(whereClause, ` AND {{ .PluralName }}.project_name = ?`)
			args = append(args, filter.ProjectName)
		}
	{{ end }}

	{{ if .HasParent }}
		if filter.{{ .ParentName | pascalcase }}Name != nil {
			whereClause = append(whereClause, ` AND {{ .PluralName }}.{{ .ParentName }}_name = ?`)
			args = append(args, filter.{{ .ParentName | pascalcase }}Name)
		}
	{{ end }}

		if filter.Name != nil {
			whereClause = append(whereClause, ` AND {{ .PluralName }}.name = ?`)
			args = append(args, filter.Name)
		}

		sqlStmtComplete := fmt.Sprintf(sqlStmt, strings.Join(whereClause, " "))

		rows, err := r.db.QueryContext(ctx, sqlStmtComplete, args...)
		if err != nil {
			return nil, sqlite.MapErr(err)
		}

		defer func() { _ = rows.Close() }()

		var {{ .PluralName | camelcase }} inventory.{{ .PluralName | pascalcase }}
		for rows.Next() {
			var {{ .Name | camelcase }} inventory.{{ .Name | pascalcase }}
			{{ .Name | camelcase }}, err = scan{{ .Name | pascalcase }}(rows)
			if err != nil {
				return nil, sqlite.MapErr(err)
			}

			{{ .PluralName | camelcase }} = append({{ .PluralName | camelcase }}, {{ .Name | camelcase }})
		}

		if rows.Err() != nil {
			return nil, sqlite.MapErr(rows.Err())
		}

		return {{ .PluralName | camelcase }}, nil
	})
}

func (r {{ .Name | camelcase }}) selectStmtGetAllUUIDWithFilter(filter inventory.{{ .Name | pascalcase }}Filter) (query string, args []any) {
	const sqlStmt = `
SELECT {{ .PluralName }}.uuid
FROM {{ .PluralName }}
  INNER JOIN clusters ON {{ .PluralName }}.cluster_id = clusters.id
{{- if .ServerIDByLocation }}
  {{ if .IsServerIDOptional }}LEFT{{ else }}INNER{{ end}} JOIN servers ON {{ .PluralName }}.server_id = servers.id
{{- end }}
WHERE true
%s
ORDER BY {{ .PluralName }}.id
`

	var whereClause []string

	if filter.Cluster != nil {
		whereClause = append(whereClause, ` AND clusters.name = ?`)
		args = append(args, filter.Cluster)
	}

{{ if .ServerIDByLocation }}
	if filter.Server != nil {
		whereClause = append(whereClause, ` AND servers.name = ?`)
		args = append(args, filter.Server)
	}
{{ end }}

{{ if .HasProject }}
	if filter.ProjectName != nil {
		whereClause = append(whereClause, ` AND {{ .PluralName }}.project_name = ?`)
		args = append(args, filter.ProjectName)
	}
{{ end }}

{{ if .HasParent }}
	if filter.{{ .ParentName | pascalcase }}Name != nil {
		whereClause = append(whereClause, ` AND {{ .PluralName }}.{{ .ParentName }}_name = ?`)
		args = append(args, filter.{{ .ParentName | pascalcase }}Name)
	}
{{ end }}

	if filter.Name != nil {
		whereClause = append(whereClause, ` AND {{ .PluralName }}.name = ?`)
		args = append(args, filter.Name)
	}

	return fmt.Sprintf(sqlStmt, strings.Join(whereClause, " ")), args
}

func (r {{ .Name | camelcase }}) GetAllUUIDsWithFilter(ctx context.Context, filter inventory.{{ .Name | pascalcase }}Filter) ([]uuid.UUID, error) {
	return transaction.DoAndReturn(ctx, func(ctx context.Context) ([]uuid.UUID, error) {
		sqlStmt, args := r.selectStmtGetAllUUIDWithFilter(filter)

		rows, err := r.db.QueryContext(ctx, sqlStmt, args...)
		if err != nil {
			return nil, sqlite.MapErr(err)
		}

		defer func() { _ = rows.Close() }()

		var ids []uuid.UUID
		for rows.Next() {
			var id uuid.UUID
			err := rows.Scan(&id)
			if err != nil {
				return nil, sqlite.MapErr(err)
			}

			ids = append(ids, id)
		}

		if rows.Err() != nil {
			return nil, sqlite.MapErr(rows.Err())
		}

		return ids, nil
	})
}

