---

- name: "dummy"
  description: "dummy description"
  match:
    - manufacturer: ".*Dummy Inc.*"
      model: ".*Dummy Model.*"
      processor_manufacturer: "Intel"
      processor_architecture: "x86"
      processor_instruction_set: "x64-64"
      cpu_sockets: 1
      has_tpm: true
      bios_version: "> 0.0.0"
  priority: 100
  attributes:
    AdminName: "root"
    ServerPrimaryOs: "IncusOS"
  deferred_attributes:
    Tpm2Algorithm: "SHA256"
  secure_boot:
    db:
      certificates:
        # Nothing is allow listed out of the box, so the CAs, the option ROMs of
        # the hardware are signed with, have to be named here to survive the wipe.
        # Microsoft Corporation UEFI CA 2011
        "48e99b991f57fc52f76149599bff0a58c47154229b9f8d603ac40d3500248507": true
        # Microsoft Option ROM UEFI CA 2023
        "e5be3e64c6e66a281457ecdece0d6d0787577aad2a3a0144262c10c14ba8d8f1": true
      signatures:
        "signature-value": true
    dbx:
      certificates:
        "sha256-fingerprint": true
      signatures:
        "signature-value": true
    kek:
      certificates:
        "sha256-fingerprint": true
      signatures:
        "signature-value": true
